import {
  "moonbitlang/core/math",
  "wzzc-dev/moui",
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/services",
  "wzzc-dev/moui/views",
  "wzzc-dev/moui_3d",
}

supported_targets = "+native+wasm-gc"

options(
  "pre-build": [
    {
      "command": ":embed --text --input $input --output $output --name wukong_gltf",
      "input": "wukong.gltf",
      "output": "wukong_embedded.mbt",
    },
  ],
  targets: { },
)
